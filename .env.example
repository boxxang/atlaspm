# Any Postgres will do. Locally: `brew install postgresql@17`,
# `brew services start postgresql@17`, `createdb atlaspm_dev atlaspm_test`.
# Deployed: the pooled connection string from your Postgres provider.
# The user matters — a Homebrew Postgres has no `postgres` role, only one
# named after you. Omitting it gives Prisma P1010, "denied access".
DATABASE_URL="postgresql://YOUR_MACOS_USERNAME@localhost:5432/atlaspm_dev"
