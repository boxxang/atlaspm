// AtlasPM — domain model per CLAUDE.md.
//
// Postgres everywhere — development, the e2e suite and the deployed app. There
// was a period when local dev ran on SQLite and the models were kept portable
// between the two; that is over, and Prisma fixes the provider at generate time
// anyway, so there is no second engine to keep in step.
//
// `kind` columns are String rather than enum. They discriminate rows the app
// reads by hand (a Post is an update, risk, note, handover or reply), and the
// set changes as the app does; a String costs nothing and a migration.
//
// Ids are supplied by the caller — client-generated at mutation time, seed
// values at seed time — so an optimistic row and the stored row share an
// identity. StepState is the exception, and says why on the field.

// Prisma 7 keeps the connection URL out of the schema: Migrate reads it from
// prisma.config.ts, and PrismaClient gets a driver adapter (see src/lib/db.ts).
datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

/// A schedule profile: the ordered list of stages a program runs on. The
/// built-in profile is seeded from /data/scheduleProfiles.ts and stays
/// immutable. Editing a program's stages applies to that program: if it shares
/// its profile with anyone, it gets a private copy first, so no other program is
/// ever rescheduled by someone else's edit.
model Profile {
  id               String   @id
  name             String
  builtin          Boolean  @default(false)
  /// Listed as a template others can start from. A program that edits its own
  /// stages gets a private profile (template = false) so the edit lands on that
  /// program alone; "Save as template" is what publishes one.
  template         Boolean  @default(false)
  /// A digest of the activity rows this profile was written from, for the
  /// built-in one only. It answers "are the stored rows still what the code
  /// says" without reading 259 rows on every render. It replaced a count, which
  /// could not see the renumbering: every reference kept its spelling and
  /// changed its meaning, so 259 still equalled 259. Null on a profile stored
  /// before the column existed, which rewrites it once.
  activityRevision String?
  createdAt        DateTime @default(now())

  stages     ProfileStage[]
  activities ProfileActivity[]
  projects   Project[]
}

/// One stage of a profile. `key` is what every per-program row (items,
/// deliverables, leaders, contacts, overrides, stage details) points at, and it
/// survives a fork, so a forked program keeps its content.
model ProfileStage {
  id         String  @id
  profileId  String
  key        String
  /// Position on the chart's y-axis, and the order the date ripple walks.
  order      Int
  title      String
  shortTitle String
  /// Lifecycle band: define | designVerify | implement | manufacture | integrate | validateRamp
  phaseId    String
  /// The built-in stage whose text and drawing this stage shows; null for a
  /// stage someone added, which starts blank.
  baseKey    String?

  startOffsetWeeks Float
  durationWeeks    Float

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, key])
  @@index([profileId])
}

/// An activity a template's stage runs.
///
/// Inherited or owned, never half of each. `baseRef` names the built-in
/// activity whose steps and write-up this one shows, the way
/// ProfileStage.baseKey names the stage whose text and drawing it shows; null
/// means the activity was added or edited here and owns its steps in ProfileStep.
model ProfileActivity {
  id         String  @id
  profileId  String
  /// The stage it belongs to, by key rather than by row: stage keys survive a
  /// copy, which is what lets an activity travel with its stage.
  stageKey   String
  /// Stored, not derived from position. Deleting the third of eleven leaves a
  /// gap, and a gap is correct — the alternative is silently repointing
  /// somebody's recorded work at a different activity.
  ref        String
  order      Int
  title      String
  /// Weeks from the stage's own start.
  windowFrom Float
  windowTo   Float
  /// The built-in activity this one shows; null for one added or edited here.
  baseRef    String?

  profile Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  steps   ProfileStep[]

  @@unique([profileId, ref])
  @@index([profileId, stageKey])
}

/// A step of an owned activity. An inherited activity has none of these.
model ProfileStep {
  id         String @id
  activityId String
  n          Int
  text       String
  /// Weeks.
  tat        Float
  /// main | par — a parallel step runs alongside the main step before it.
  lane       String @default("main")

  activity ProfileActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@unique([activityId, n])
  @@index([activityId])
}

model Project {
  id                    String   @id
  name                  String
  kickoff               DateTime
  profileId             String
  /// Orders the program list; ids are caller-supplied, so they sort by nothing.
  createdAt             DateTime @default(now())
  /// Fully-loaded cost of one man-month, for the effort estimate. 0 = not set,
  /// which shows the effort without pretending to know what it costs.
  costPerManMonth       Float    @default(0)
  currency              String   @default("USD")
  /// What completing a meeting does when its checks fail: warn | block. A
  /// programme that wants minutes and owned actions before a meeting can close
  /// says so here; the default only warns.
  meetingCompletionMode String   @default("warn")

  profile Profile @relation(fields: [profileId], references: [id])

  overrides    StageOverride[]
  items        Item[]
  deliverables Deliverable[]
  leaders      Leader[]
  contacts     Contact[]
  stageDetails StageDetail[]
  qorDatasets  QorDataset[]
  posts        Post[]
  stepStates   StepState[]
  attachments  Attachment[]

  meetingSeries    MeetingSeries[]
  meetings         Meeting[]
  meetingAttendees MeetingAttendee[]
  meetingAgenda    MeetingAgendaItem[]
  meetingDecisions MeetingDecision[]
  actionItems      ActionItem[]
  meetingLinks     MeetingLink[]
  meetingFiles     MeetingFile[]
}

/// The ONLY schedule mutation surface — baseline profiles are immutable code.
/// Rows hold the effective offsets/durations for every stage once any edit
/// lands, so reading them back needs no replay of the edit history.
model StageOverride {
  id        String @id
  projectId String
  stageId   String

  startOffsetWeeks Float
  durationWeeks    Float

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, stageId])
}

model Item {
  id            String    @id
  projectId     String
  stageId       String
  /// keyinfo | activity | risk
  kind          String
  title         String
  body          String    @default("")
  owner         String
  /// Who opened it. The communication board is a board people post on, so the
  /// person who started a thread is a different fact from the person carrying
  /// the work — `owner` answers who is on it, this answers who raised it.
  /// Defaulted rather than required: the other two boards have no posters.
  author        String    @default("")
  /// What the post is about, when it is about one piece of work. The stage is
  /// already known from stageId; this narrows it to an activity and, if the
  /// poster went that far, to a step of it. Steps are content addressed by
  /// reference, so they are named the way every other step reference is.
  activityRef   String?
  stepN         Int?
  due           DateTime?
  done          Boolean   @default(false)
  updatedAt     DateTime
  /// The key deliverable this activity is work towards, if it is towards one.
  /// SetNull rather than Cascade: deleting a deliverable must not delete the
  /// record of the work that went into it.
  deliverableId String?

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  posts       Post[]
  attachments Attachment[]
  deliverable Deliverable? @relation(fields: [deliverableId], references: [id], onDelete: SetNull)

  @@index([projectId, stageId, kind])
  @@index([deliverableId])
}

/// Something somebody wrote, with whatever they attached and the replies under it.
///
/// Four surfaces in the app are this one shape — an update posted on a step, a risk
/// flagged on a step, a note on a stage's key-info board, and the handover that
/// completes a deliverable — so they are one table rather than four, and one
/// renderer rather than four. This started life as StatusUpdate, which was the same
/// row with only one place to hang from.
///
/// Exactly one target is set. A reply sets `parentId` and nothing else: it belongs
/// to its parent, and the parent knows where it is.
model Post {
  id        String    @id
  projectId String
  /// update | risk | note | handover | reply
  kind      String
  text      String
  author    String
  createdAt DateTime
  editedAt  DateTime?

  /// The V1 target: a post on a board item. Still how the boards work.
  itemId        String?
  /// A post on one step of one activity. Steps are content, not rows, so they are
  /// addressed by the reference the write-up uses — "PD-10" — and the step number.
  activityRef   String?
  stepN         Int?
  /// A note on a stage's key-info board: something the programme learned that is
  /// worth finding again. It belongs to the stage rather than to any one piece of
  /// work in it, which is why it needs a target of its own.
  stageId       String?
  /// The handover that completes a deliverable.
  deliverableId String?
  /// A reply. Replies do not nest: a reply's parent is always a top-level post.
  parentId      String?

  /// Set on a handover: the day the deliverable was accepted. A handover without
  /// one is a record of what was sent, not a claim that it is finished.
  doneAt DateTime?

  /// The meeting a risk was raised in, when it was raised in one. A source,
  /// not a target: the risk still lives on its step and closes with it, and
  /// cancelling or completing the meeting does nothing to it.
  meetingId String?

  /// A key-info note's body as a rich-text document (Tiptap JSON): paragraphs,
  /// headings, lists and tables. `text` still carries the title and the body
  /// as plain text, which is what the list, the filter and the Updates feed
  /// read. Null on every other kind of post, and on a note written before
  /// notes had documents, which shows its text as it always did.
  doc String?

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  item        Item?        @relation(fields: [itemId], references: [id], onDelete: Cascade)
  deliverable Deliverable? @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  parent      Post?        @relation("PostReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies     Post[]       @relation("PostReplies")
  meeting     Meeting?     @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  attachments Attachment[]

  @@index([itemId])
  @@index([parentId])
  @@index([deliverableId])
  @@index([projectId, kind])
  @@index([projectId, activityRef, stepN])
  @@index([projectId, stageId])
  @@index([meetingId])
}

/// What has happened to one step of one activity.
///
/// The steps themselves are content — /data/activityDetails.ts, generated from the
/// authoring document — so there is no Step table to hang a foreign key on. A row
/// here is the programme's answer for one of them, and absent means "untouched",
/// which is why every column is optional or defaulted.
model StepState {
  /// Minted here, unlike everywhere else in this schema, because a step is not
  /// addressed by it: the identity is (projectId, activityRef, stepN), which
  /// the client already knows. There is no optimistic row to keep in step with.
  id          String @id @default(cuid())
  projectId   String
  activityRef String
  stepN       Int

  done        Boolean   @default(false)
  /// When it was handed over — stamped by the first output attached to it.
  doneAt      DateTime?
  /// 0-100, typed by hand. A done step reads 100 whatever this says.
  pct         Int       @default(0)
  /// Who is answerable. Empty means unassigned; the template's lead *role* is a
  /// different thing and does not belong here.
  owner       String    @default("")
  /// Overrides the date the schedule computes for this step. Null keeps the
  /// baseline, so clearing an override is a delete rather than a recalculation.
  dueOverride DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, activityRef, stepN])
  @@index([projectId])
}

/// Files attached to an item, to a post, to a deliverable, or to one step.
///
/// Bytes live in the database rather than on disk: the deploy target is
/// Vercel, whose filesystem is read-only and whose instances do not outlive a
/// request, so `Bytes` (bytea) keeps the file with the rest of the row.
/// That caps the sensible file size (see MAX_ATTACHMENT_BYTES); moving to object
/// storage later means replacing `data` with a URL and nothing else.
model Attachment {
  id            String   @id
  /// Which programme it belongs to.
  ///
  /// The other three targets carry this implicitly — an attachment on an item,
  /// a post or a deliverable reaches its programme through that row. An output
  /// attached to a step has no such row: steps are content, addressed by
  /// reference, and "PD-10 step 2" names a step of every programme at once. So
  /// the programme is stated here, and it is stated on all four rather than only
  /// where it is load-bearing — a column that is sometimes the answer and
  /// sometimes null is a column nobody trusts.
  projectId     String
  itemId        String?
  postId        String?
  /// A deliverable's artefact — what makes it a delivered deliverable.
  deliverableId String?
  /// The output a step hands over. Attaching one is what completes the step, so
  /// this is evidence rather than decoration.
  activityRef   String?
  stepN         Int?
  /// A file on a meeting's Files tab, a decision's evidence, or the evidence
  /// that closed an action item. The MeetingFile row says which; the bytes
  /// stay here, served by the same route as every other attachment.
  meetingFileId String?
  filename      String
  mimeType      String
  size          Int
  data          Bytes
  createdAt     DateTime

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  item        Item?        @relation(fields: [itemId], references: [id], onDelete: Cascade)
  post        Post?        @relation(fields: [postId], references: [id], onDelete: Cascade)
  deliverable Deliverable? @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  meetingFile MeetingFile? @relation(fields: [meetingFileId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@index([postId])
  @@index([deliverableId])
  @@index([projectId, activityRef, stepN])
  @@index([meetingFileId])
}

model Deliverable {
  id          String    @id
  projectId   String
  stageId     String
  title       String
  due         DateTime?
  done        Boolean   @default(false)
  completedAt DateTime?
  /// How the thing came to be: the development history written when it was
  /// filed. Kept beside the artefact, because neither is much use alone.
  note        String    @default("")
  /// Preserves seed / insertion order within a stage.
  position    Int

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  attachments Attachment[]
  items       Item[]
  posts       Post[]

  @@index([projectId, stageId])
}

/// Per-program edits to a stage's descriptive text. Stage definitions live in
/// code and are shared by every program; a row here overrides one program's
/// copy. A null column means "use the shared default", so restoring a field is
/// a delete rather than a re-copy. List columns are newline-separated: SQLite
/// has no array type and a String column moves to Postgres unchanged.
model StageDetail {
  id        String @id
  projectId String
  stageId   String

  description       String?
  engineeringView   String?
  /// Man-months per engineering line, newline-separated and index-aligned to
  /// engineeringView — including when that list is the shared default.
  engineeringEffort String?
  /// Elapsed weeks per engineering line, stored the same way. Negative marks an
  /// activity that runs continuously across the stage rather than closing once.
  engineeringTat    String?
  programView       String?
  tools             String?
  collaboration     String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, stageId])
}

/// A QoR workbook for one stage of one programme: per-block, per-netlist-drop
/// physical-design numbers, parsed in the browser and stored whole.
///
/// One row, not a table of blocks and a table of drops. The dashboard reads
/// every number at once and nothing else joins against them, so normalising
/// would buy queries nobody makes and charge a migration for every measure the
/// design team adds. `payload` is the parsed dataset as JSON, the way Post.doc
/// holds a rich-text document.
model QorDataset {
  id        String @id
  projectId String
  stageId   String

  /// the name of the file it was read from, shown beside the data
  fileName   String
  uploadedAt DateTime
  /// QorDataset from /lib/qor/schema.ts, JSON.stringify'd
  payload    String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, stageId])
}

model Leader {
  id        String @id
  projectId String
  stageId   String
  name      String
  short     String
  phone     String
  email     String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, stageId])
}

model Contact {
  id        String @id
  projectId String
  stageId   String
  name      String
  role      String
  email     String
  phone     String
  /// Preserves seed / insertion order within a stage.
  position  Int

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, stageId])
}

// ─────────────────────────────── meetings ───────────────────────────────
//
// A meeting is its own object, not a kind of activity or step. A series is how
// a meeting recurs; a Meeting row is one sitting of it, and everything said at
// that sitting — agenda, minutes, decisions, action items — hangs off the
// sitting, never the series. Decisions and actions are stored once and every
// screen reads the same row.
//
// Every row carries projectId, and every read and write is scoped by it. People
// are names, as they are everywhere else in this schema: there is no Person
// table to reference, and inventing one for meetings would be a second directory.

/// How a meeting recurs, and what each sitting starts with.
model MeetingSeries {
  id              String   @id
  projectId       String
  title           String
  purpose         String   @default("")
  /// program_review | working_group | war_room | supplier_review | readiness_review | design_review | bringup | ad_hoc
  type            String   @default("working_group")
  owner           String   @default("")
  /// Default attendees, newline-separated.
  attendees       String   @default("")
  /// The RecurrenceRule as JSON — see /lib/meetings/recurrence.ts.
  recurrence      String   @default("{}")
  durationMinutes Int      @default(60)
  /// Agenda titles each new sitting starts with, newline-separated.
  agendaTemplate  String   @default("")
  timeZone        String   @default("UTC")
  location        String   @default("")
  /// program | stage_team | invitees
  accessScope     String   @default("program")
  /// active | inactive
  status          String   @default("active")
  createdAt       DateTime
  updatedAt       DateTime
  createdBy       String   @default("")
  updatedBy       String   @default("")

  project  Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  meetings Meeting[]
  links    MeetingLink[]

  @@index([projectId])
}

/// One sitting.
model Meeting {
  id           String    @id
  projectId    String
  seriesId     String?
  title        String
  type         String    @default("working_group")
  /// draft | scheduled | in_progress | completed | cancelled
  status       String    @default("scheduled")
  startsAt     DateTime
  endsAt       DateTime
  /// The zone the times were set in; the instant is stored, the zone says how to read it.
  timeZone     String    @default("UTC")
  owner        String    @default("")
  facilitator  String    @default("")
  /// A room or a meeting link.
  location     String    @default("")
  purpose      String    @default("")
  /// Free-form minutes. Each agenda item carries its own discussion notes too.
  minutes      String    @default("")
  completedAt  DateTime?
  cancelReason String    @default("")
  createdAt    DateTime
  updatedAt    DateTime
  createdBy    String    @default("")
  updatedBy    String    @default("")

  project   Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// SetNull: retiring a series must not delete the record of what its sittings decided.
  series    MeetingSeries?      @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  attendees MeetingAttendee[]
  agenda    MeetingAgendaItem[]
  decisions MeetingDecision[]
  actions   ActionItem[]        @relation("ActionSource")
  carriedIn ActionItem[]        @relation("ActionCarriedTo")
  links     MeetingLink[]
  files     MeetingFile[]
  risks     Post[]

  @@index([projectId, startsAt])
  @@index([seriesId])
}

model MeetingAttendee {
  id        String  @id
  projectId String
  meetingId String
  name      String
  optional  Boolean @default(false)
  position  Int     @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId])
}

model MeetingAgendaItem {
  id            String   @id
  projectId     String
  meetingId     String
  position      Int
  title         String
  description   String   @default("")
  presenter     String   @default("")
  /// Allocated minutes.
  minutes       Int      @default(0)
  /// What was said — the structured half of the minutes.
  notes         String   @default("")
  /// info | decision | action | risk | escalation | deferred; empty until discussed
  outcome       String   @default("")
  /// pending | discussed
  status        String   @default("pending")
  /// next_meeting | offline | dropped — what happens to a deferred item
  deferral      String   @default("")
  deferNote     String   @default("")
  /// The item this was carried in from, at an earlier sitting.
  carriedFromId String?
  createdAt     DateTime
  updatedAt     DateTime
  createdBy     String   @default("")
  updatedBy     String   @default("")

  project     Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  meeting     Meeting             @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  carriedFrom MeetingAgendaItem?  @relation("AgendaCarry", fields: [carriedFromId], references: [id], onDelete: SetNull)
  carriedTo   MeetingAgendaItem[] @relation("AgendaCarry")
  decisions   MeetingDecision[]
  actions     ActionItem[]
  links       MeetingLink[]

  @@index([meetingId])
}

model MeetingDecision {
  id           String    @id
  projectId    String
  meetingId    String
  /// The agenda item it came out of, if one.
  agendaItemId String?
  title        String
  description  String    @default("")
  owner        String    @default("")
  approvedBy   String    @default("")
  decidedOn    DateTime?
  rationale    String    @default("")
  /// What it applies to, in words.
  scope        String    @default("")
  /// proposed | approved | superseded | rejected
  status       String    @default("proposed")
  supersedesId String?
  createdAt    DateTime
  updatedAt    DateTime
  createdBy    String    @default("")
  updatedBy    String    @default("")

  project      Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  meeting      Meeting            @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  agendaItem   MeetingAgendaItem? @relation(fields: [agendaItemId], references: [id], onDelete: SetNull)
  supersedes   MeetingDecision?   @relation("DecisionSupersedes", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy MeetingDecision[]  @relation("DecisionSupersedes")
  links        MeetingLink[]
  files        MeetingFile[]

  @@index([meetingId])
  @@index([projectId, status])
}

/// A promise with one name and one date on it.
///
/// Its source meeting is nullable so an action can later be raised from a risk
/// or a step directly with the same shape. Completing one changes no step and
/// no activity; converting one to a step is a separate, explicit act that
/// records the step it became.
model ActionItem {
  id                   String    @id
  projectId            String
  meetingId            String?
  agendaItemId         String?
  description          String
  /// Accountable owner — one name.
  owner                String    @default("")
  /// Newline-separated.
  contributors         String    @default("")
  dueDate              DateTime?
  /// critical | high | normal | low
  priority             String    @default("normal")
  /// open | in_progress | blocked | done | cancelled
  status               String    @default("open")
  /// support | new_step | standalone
  actionType           String    @default("support")
  evidence             String    @default("")
  blocker              String    @default("")
  escalationDate       DateTime?
  verifiedBy           String    @default("")
  completedAt          DateTime?
  /// none | step_at_risk | activity_end | milestone | not_assessed — a judgement, never a date change
  scheduleImpact       String    @default("")
  impactNote           String    @default("")
  /// The later sitting it was carried into. It still belongs to its source.
  carriedToMeetingId   String?
  /// The step it became, once converted.
  convertedActivityRef String?
  convertedStepN       Int?
  createdAt            DateTime
  updatedAt            DateTime
  createdBy            String    @default("")
  updatedBy            String    @default("")

  project    Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  meeting    Meeting?           @relation("ActionSource", fields: [meetingId], references: [id], onDelete: Cascade)
  agendaItem MeetingAgendaItem? @relation(fields: [agendaItemId], references: [id], onDelete: SetNull)
  carriedTo  Meeting?           @relation("ActionCarriedTo", fields: [carriedToMeetingId], references: [id], onDelete: SetNull)
  links      MeetingLink[]
  files      MeetingFile[]

  @@index([projectId, status])
  @@index([meetingId])
  @@index([carriedToMeetingId])
}

/// What a meeting row is about. Exactly one owner column is set; the target is
/// addressed the way the rest of the app addresses it, because steps have no
/// rows: `stage` a stage key, `activity` a ref, `step` `ref:n`, `risk` the post
/// id, `deliverable` its id, `milestone` its id.
model MeetingLink {
  id           String   @id
  projectId    String
  seriesId     String?
  meetingId    String?
  agendaItemId String?
  decisionId   String?
  actionItemId String?
  /// stage | activity | step | risk | deliverable | milestone
  targetType   String
  targetRef    String
  createdAt    DateTime
  createdBy    String   @default("")

  project    Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  series     MeetingSeries?     @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  meeting    Meeting?           @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  agendaItem MeetingAgendaItem? @relation(fields: [agendaItemId], references: [id], onDelete: Cascade)
  decision   MeetingDecision?   @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  actionItem ActionItem?        @relation(fields: [actionItemId], references: [id], onDelete: Cascade)

  @@index([projectId, targetType, targetRef])
  @@index([meetingId])
  @@index([agendaItemId])
  @@index([decisionId])
  @@index([actionItemId])
  @@index([seriesId])
}

/// A file or a link on a meeting, a decision's supporting evidence, or the
/// evidence that closed an action. Uploaded bytes live in Attachment.
model MeetingFile {
  id           String   @id
  projectId    String
  meetingId    String?
  decisionId   String?
  actionItemId String?
  /// presentation | report | analysis | attachment | link | evidence
  category     String   @default("attachment")
  title        String
  url          String   @default("")
  createdAt    DateTime
  createdBy    String   @default("")

  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  meeting     Meeting?         @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  decision    MeetingDecision? @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  actionItem  ActionItem?      @relation(fields: [actionItemId], references: [id], onDelete: Cascade)
  attachments Attachment[]

  @@index([meetingId])
  @@index([decisionId])
  @@index([actionItemId])
}
