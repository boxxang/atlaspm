// AtlasPM — domain model per CLAUDE.md.
//
// Provider is sqlite for local dev; the models stay Postgres-compatible so
// production can switch the datasource without touching a model:
//  - no SQLite-only types, no native type attributes
//  - `kind` and `profileId` are String rather than enum (SQLite has no enums,
//    and a String column migrates to Postgres unchanged)
//  - ids are supplied by the caller (client-generated at mutation time, seed
//    values at seed time) so optimistic UI and the database agree on them

// Prisma 7 keeps the connection URL out of the schema: Migrate reads it from
// prisma.config.ts, and PrismaClient gets a driver adapter (see src/lib/db.ts).
datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

model Project {
  id        String   @id
  name      String
  kickoff   DateTime
  profileId String
  /// Orders the program list; ids are caller-supplied, so they sort by nothing.
  createdAt DateTime @default(now())
  /// Fully-loaded cost of one man-month, for the effort estimate. 0 = not set,
  /// which shows the effort without pretending to know what it costs.
  costPerManMonth Float  @default(0)
  currency        String @default("USD")

  overrides    StageOverride[]
  items        Item[]
  deliverables Deliverable[]
  leaders      Leader[]
  contacts     Contact[]
  stageDetails StageDetail[]
}

/// The ONLY schedule mutation surface — baseline profiles are immutable code.
/// Rows hold the effective offsets/durations for every stage once any edit
/// lands, so reading them back needs no replay of the edit history.
model StageOverride {
  id        String @id
  projectId String
  stageId   String

  startOffsetWeeks Float
  durationWeeks    Float

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, stageId])
}

model Item {
  id        String    @id
  projectId String
  stageId   String
  /// keyinfo | activity | risk
  kind      String
  title     String
  body      String    @default("")
  owner     String
  due       DateTime?
  done      Boolean   @default(false)
  updatedAt DateTime

  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  updates     StatusUpdate[]
  attachments Attachment[]

  @@index([projectId, stageId, kind])
}

model StatusUpdate {
  id        String   @id
  itemId    String
  text      String
  createdAt DateTime

  item        Item         @relation(fields: [itemId], references: [id], onDelete: Cascade)
  attachments Attachment[]

  @@index([itemId])
}

/// Files attached to an item or to one of its status updates.
///
/// Bytes live in the database rather than on disk: the documented deploy target
/// is Vercel, whose filesystem is read-only, and `Bytes` maps to BLOB on SQLite
/// and bytea on Postgres, so the column travels with the rest of the schema.
/// That caps the sensible file size (see MAX_ATTACHMENT_BYTES); moving to object
/// storage later means replacing `data` with a URL and nothing else.
model Attachment {
  id             String   @id
  itemId         String?
  statusUpdateId String?
  filename       String
  mimeType       String
  size           Int
  data           Bytes
  createdAt      DateTime

  item   Item?         @relation(fields: [itemId], references: [id], onDelete: Cascade)
  update StatusUpdate? @relation(fields: [statusUpdateId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@index([statusUpdateId])
}

model Deliverable {
  id          String    @id
  projectId   String
  stageId     String
  title       String
  due         DateTime?
  done        Boolean   @default(false)
  completedAt DateTime?
  /// Preserves seed / insertion order within a stage.
  position    Int

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, stageId])
}

/// Per-program edits to a stage's descriptive text. Stage definitions live in
/// code and are shared by every program; a row here overrides one program's
/// copy. A null column means "use the shared default", so restoring a field is
/// a delete rather than a re-copy. List columns are newline-separated: SQLite
/// has no array type and a String column moves to Postgres unchanged.
model StageDetail {
  id        String @id
  projectId String
  stageId   String

  description     String?
  engineeringView String?
  /// Man-months per engineering line, newline-separated and index-aligned to
  /// engineeringView — including when that list is the shared default.
  engineeringEffort String?
  programView     String?
  tools           String?
  collaboration   String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, stageId])
}

model Leader {
  id        String @id
  projectId String
  stageId   String
  name      String
  short     String
  phone     String
  email     String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, stageId])
}

model Contact {
  id        String @id
  projectId String
  stageId   String
  name      String
  role      String
  email     String
  phone     String
  /// Preserves seed / insertion order within a stage.
  position  Int

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, stageId])
}
